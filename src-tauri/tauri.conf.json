{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote Pilot for GitHub Copilot",
  "version": "0.1.0",
  "identifier": "com.wsawyerr.remote-pilot-for-github-copilot-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Remote Pilot for GitHub Copilot",
        "width": 800,
        "height": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
